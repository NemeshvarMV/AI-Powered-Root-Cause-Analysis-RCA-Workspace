# ==============================================================================
# AIVOA.AI — Root Cause Analysis Workspace
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AIVOA.AI — Root Cause Analysis Workspace"
VERSION=1.0.0

# Database Connection (PostgreSQL 14+ recommended)
DATABASE_URL=
# Groq AI Model Configuration
# Obtain your free API key at: https://console.groq.com/keys
# Supported models: llama-3.3-70b-versatile, gemma2-9b-it, llama-3.1-8b-instant
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile

# Storage & File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Frontend Host (for CORS)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
