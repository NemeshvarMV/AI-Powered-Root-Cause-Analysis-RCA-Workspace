# ==============================================================================
# AIVOA.AI — Frontend Production Environment Configuration
# ==============================================================================

# Custom Domain Backend API Base URL
# If hosting frontend and backend under the same domain or behind a reverse proxy (e.g. Cloudflare, Nginx, AWS ALB),
# leave VITE_API_BASE unset or empty so requests use relative path '/api/v1'.
# If backend is hosted on a separate custom domain/subdomain, specify it here:
# VITE_API_BASE=https://api.yourcustomdomain.com
VITE_API_BASE=
